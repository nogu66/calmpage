{
  "name": "sumitex",
  "productName": "Sumitex",
  "version": "0.3.0",
  "description": "Sumitex: a quiet LaTeX editor for macOS with a live PDF preview and an optional AI panel",
  "license": "MIT",
  "author": "nogu66",
  "repository": {
    "type": "git",
    "url": "https://github.com/nogu66/sumitex.git"
  },
  "homepage": "https://github.com/nogu66/sumitex",
  "bugs": "https://github.com/nogu66/sumitex/issues",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs"
  },
  "build": {
    "appId": "me.noguchy.sumitex",
    "productName": "Sumitex",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": "dir",
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": "tex",
        "name": "LaTeX Document",
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^2.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
